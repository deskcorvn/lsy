# Kết nối Medusa (BE-GiftyID) — SERVER-ONLY, không NEXT_PUBLIC_
MEDUSA_URL=https://api.giftytech.com
MEDUSA_PUBLISHABLE_KEY=pk_thay-bang-key-cua-khach
# Bí mật xác thực webhook revalidate (đặt chuỗi mạnh, ≥ 8 ký tự)
REVALIDATE_SECRET=doi-thanh-chuoi-bi-mat-manh

# Multi-tenant store: CÓ → dùng Postgres (Neon) cho "form → site tức thì" (prod);
# KHÔNG → fallback file tenants/*.json (local/dev). Đặt ở .env.local (đã gitignore).
DATABASE_URL=postgresql://user:pass@host.neon.tech/dbname?sslmode=require
